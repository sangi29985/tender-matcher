# Required
SAM_GOV_API_KEY=
ANTHROPIC_API_KEY=

# Database: SQLite for local development; compose.yaml sets Postgres for you.
DATABASE_URL=sqlite:///./tender_matcher.db

# Matching
ANTHROPIC_MODEL=claude-sonnet-5-5
TOP_K=30
JUDGE_CONCURRENCY=4
MAX_ATTACHMENTS=5
ATTACHMENT_CHAR_LIMIT=60000

# Hosting: set APP_BASE_URL to the public https address and COOKIE_SECURE=true behind HTTPS.
APP_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
ALLOW_SIGNUP=true
POSTGRES_PASSWORD=change-me

# Daily job (worker) and email digest. Leave SMTP_HOST empty to skip emails.
DAILY_RUN_HOUR_UTC=11
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Live deployment with HTTPS (docker compose --profile https up -d)
DOMAIN=
ADMIN_EMAIL=
